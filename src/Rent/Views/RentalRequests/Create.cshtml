@model TheatreCMS3.Areas.Rent.Models.RentalRequest

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@*Needed for DateTime picker -- Note the JavaScript in <script> tag is writtern at bottom of this page*@
<head>
    <link rel="stylesheet" href="//code.jquery.com/ui/1.11.1/themes/smoothness/jquery-ui.css">
    <script src="//code.jquery.com/jquery-1.10.2.js"></script>
    <script src="//code.jquery.com/ui/1.11.1/jquery-ui.js"></script>
</head>

<h2 class="jumbotron rentalRequests-Create--Heading">Create Rental Request</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">
        @Html.ValidationSummary(true, "", new { @class = "rentalRequest-Create--ValidationMsg" })
        <div class="rentalRequest-Create--FormContainer">
            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.ContactPerson, htmlAttributes: new { @class = "control-label col-md-2" })
                    @Html.EditorFor(model => model.ContactPerson, new { htmlAttributes = new { @class = "form-control rentalRequest-Create--Input", @placeholder = "Contact Person" } })
                    @Html.ValidationMessageFor(model => model.ContactPerson, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.Company, htmlAttributes: new { @class = "control-label col-md-2" })
                    @Html.EditorFor(model => model.Company, new { htmlAttributes = new { @class = "form-control rentalRequest-Create--Input", @placeholder = "Company" } })
                    @Html.ValidationMessageFor(model => model.Company, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.RequestedTime, htmlAttributes: new { @class = "control-label col-md-2" })
                    @Html.EditorFor(model => model.RequestedTime, new { htmlAttributes = new { @class = "form-control rentalRequest-Create--Input", @placeholder = "Requested Time" } })
                    @Html.ValidationMessageFor(model => model.RequestedTime, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.StartTime, htmlAttributes: new { @class = "control-label col-md-2" })
                    @Html.EditorFor(model => model.StartTime, new { htmlAttributes = new { @class = "form-control rentalRequest-Create--Input", @placeholder = "Start Time" } })
                    @Html.ValidationMessageFor(model => model.StartTime, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.EndTime, htmlAttributes: new { @class = "control-label col-md-2" })
                    @Html.EditorFor(model => model.EndTime, new { htmlAttributes = new { @class = "form-control rentalRequest-Create--Input", @placeholder = "End Time" } })
                    @Html.ValidationMessageFor(model => model.EndTime, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.ProjectInfo, htmlAttributes: new { @class = "control-label col-md-2" })
                    @Html.EditorFor(model => model.ProjectInfo, new { htmlAttributes = new { @class = "form-control rentalRequest-Create--Input", @placeholder = "Project Info" } })
                    @Html.ValidationMessageFor(model => model.ProjectInfo, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.RentalCode, htmlAttributes: new { @class = "control-label col-md-2" })
                    @Html.EditorFor(model => model.RentalCode, new { htmlAttributes = new { @class = "form-control rentalRequest-Create--Input", @placeholder = "Rental Code" } })
                    @Html.ValidationMessageFor(model => model.RentalCode, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.Accepted, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="checkbox">
                        @Html.EditorFor(model => model.Accepted, new { htmlAttributes = new { @class = "rentalRequest-Create--Input" } })
                        @Html.ValidationMessageFor(model => model.Accepted, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                    </div>
                </div>
            </div>

            <div class="form-group">
                <div class="col-md-10">
                    @Html.LabelFor(model => model.ContractSigned, htmlAttributes: new { @class = "control-label col-md-2" })
                    <div class="checkbox">
                        @Html.EditorFor(model => model.ContractSigned, new { htmlAttributes = new { @class = "rentalRequest-Create--Input" } })
                        @Html.ValidationMessageFor(model => model.ContractSigned, "", new { @class = "rentalRequest-Create--ValidationMsg" })
                    </div>
                </div>
            </div>
        </div>

        <div class="form-group">
            <div>
                <input type="submit" value="Create" class="btn rentalRequest-Create--SubmitBtn" />
            </div>
        </div>
    </div>
}
<div>
    <a href="@Url.Action("Index", "RentalRequests", new { area = "Rent" })" type="button" class="btn rentalRequest-Create--BackToListBtn">Back to List</a>
</div>

@*Below code sets format to the datetimepicker having id as datetime*@
<script>
    $(function () {
        $("#RequestedTime").datepicker();
        $("#StartTime").datepicker();
        $("#EndTime").datepicker();
    });


</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
